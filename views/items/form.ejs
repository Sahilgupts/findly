<section class="narrow"><p class="eyebrow"><%= edit?'Update your listing':'Create a report' %></p><h1><%= edit?'Keep the details current.':'Let’s help it find its way.' %></h1><form class="form-card" method="POST" enctype="multipart/form-data" action="<%= edit?'/items/'+item._id+'?_method=PUT':'/items' %>"><label>I want to report a…</label><div class="segmented"><label><input required type="radio" name="type" value="lost" <%= item.type!=='found'?'checked':'' %>><span>Something I lost</span></label><label><input type="radio" name="type" value="found" <%= item.type==='found'?'checked':'' %>><span>Something I found</span></label></div><label>What is it?<input required name="title" value="<%= item.title||'' %>" placeholder="e.g. Black leather wallet"></label><div class="two"><label>Category<select required name="category"><option value="">Choose one</option><%categories.forEach(c=>{%><option <%= item.category===c?'selected':'' %>><%=c%></option><%})%></select></label><label>Date <input required type="date" name="date" value="<%= item.date?new Date(item.date).toISOString().slice(0,10):'' %>"></label></div><label>Where was it lost/found?<input required name="location" value="<%= item.location||'' %>" placeholder="e.g. Main library, second floor"></label><label>Tell us a little more<textarea required name="description" rows="5" placeholder="Include colour, brand, distinguishing features…"><%= item.description||'' %></textarea></label><label>Photo <input type="file" name="image" accept="image/*"></label><button class="button wide"><%= edit?'Save changes':'Publish report' %> <b>→</b></button></form></section>
