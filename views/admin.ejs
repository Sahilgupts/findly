<section class="page-title"><p class="eyebrow">Moderation</p><h1>Pending claims</h1><p>Review ownership details before arranging a return.</p></section><section class="admin-list"><%claims.forEach(claim=>{%><article class="claim-card"><div><span class="tag <%=claim.item.type%>"><%=claim.item.type%></span><h2><a href="/items/<%=claim.item._id%>"><%=claim.item.title%></a></h2><p><b><%=claim.claimant.name%></b> believes this item is theirs.</p><blockquote><%=claim.message%></blockquote><small>Proof: <%=claim.proof||'No additional proof supplied'%></small></div><div class="claim-actions"><form method="POST" action="/claims/<%=claim._id%>?_method=PUT"><input type="hidden" name="status" value="approved"><button class="button">Approve</button></form><form method="POST" action="/claims/<%=claim._id%>?_method=PUT"><input type="hidden" name="status" value="declined"><button class="outline">Decline</button></form></div></article><%})%><%if(!claims.length){%><div class="empty"><h2>You’re all caught up.</h2><p>There are no pending claims to review.</p></div><%}%></section>
