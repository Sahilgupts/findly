<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= typeof title !== 'undefined' ? title+' · ' : '' %>Findly</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body><header><a class="brand" href="/"><span>f</span> findly</a><nav><a class="<%= path==='/'?'active':'' %>" href="/items">Browse</a><a href="/items/new">Report an item</a><% if(currentUser){ %><a href="/dashboard">My dashboard</a><% if(currentUser.role==='admin'){ %><a href="/admin">Admin</a><% } %><form action="/logout" method="POST"><button class="nav-button">Sign out</button></form><span class="avatar"><%= currentUser.name.charAt(0) %></span><% } else { %><a href="/login">Sign in</a><a class="button small" href="/register">Join Findly</a><% } %></nav></header><main><% if(success){ %><div class="flash success"><%= success %></div><% } %><% if(error){ %><div class="flash error"><%= error %></div><% } %><%- body %></main><footer><a class="brand" href="/"><span>f</span> findly</a><p>Making lost things easier to find.</p><p>© <%= new Date().getFullYear() %> Findly</p></footer><script src="/js/app.js"></script></body></html>
