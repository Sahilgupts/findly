<section class="page-title split"><div><p class="eyebrow">Your space</p><h1>Welcome back, <%=currentUser.name.split(' ')[0]%>.</h1><p>Keep an eye on your reports and claims.</p></div><a class="button" href="/items/new">+ Report an item</a></section><section class="dashboard-grid"><div><h2>Your reports</h2><%if(items.length){items.forEach(item=>{%><a class="row-card" href="/items/<%=item._id%>"><span class="row-icon"><%=item.category==='Keys'?'🔑':'◌'%></span><span><b><%=item.title%></b><small><%=item.type%> · <%=item.location%></small></span><span class="status <%=item.status%>"><%=item.status%></span><span>→</span></a><%})}else{%><div class="empty compact"><p>You have not reported anything yet.</p><a href="/items/new">Create your first report</a></div><%}%></div><div><h2>Your claims</h2><%if(claims.length){claims.forEach(claim=>{%><a class="row-card" href="/items/<%=claim.item._id%>"><span class="row-icon">⌕</span><span><b><%=claim.item.title%></b><small>Submitted <%=new Date(claim.createdAt).toLocaleDateString()%></small></span><span class="status <%=claim.status%>"><%=claim.status%></span></a><%})}else{%><div class="empty compact"><p>No claims submitted yet.</p><a href="/items">Browse listings</a></div><%}%></div></section>
